{
  "name": "ayush-roy-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:content": "node --import tsx/esm scripts/validate-content.mjs",
    "validate:assets": "node scripts/check-asset-budget.mjs",
    "validate": "npm run test && npm run lint && npm run validate:content && npm run validate:assets && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "chess.js": "^1.4.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.185.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.0"
  }
}
